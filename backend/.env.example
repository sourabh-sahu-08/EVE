# ==============================================================================
# EVE AI Assistant — Zero-Cost Multi-Provider Configuration
# ==============================================================================
# Copy this file to '.env' and populate with your own API keys.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Strict Zero-Cost Enforcement (Keep true to reject any non-free or paid models)
ZERO_COST_MODE=true

# Optional: Master API key to protect EVE endpoints from unauthorized callers
EVE_API_KEY=

# ------------------------------------------------------------------------------
# Provider Credentials (Priority 1: Groq -> 2: Gemini -> 3: OpenRouter -> 4: Ollama)
# ------------------------------------------------------------------------------

# 1. Groq Cloud (Free tier API key from console.groq.com)
GROQ_API_KEY=

# 2. Google Gemini (Free tier API key from aistudio.google.com)
GEMINI_API_KEY=

# 3. OpenRouter (Free tier API key from openrouter.ai; strictly :free models used)
OPENROUTER_API_KEY=

# 4. Local Ollama Instance (Default local endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistence Configuration
DATA_DIR=./data
